{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noisy-water-017a",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, "404-page" would answer /api/* with the 404 page
    // before the Worker ever runs.
    "run_worker_first": ["/api/*"]
  },
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite" },
  // Per-IP limit for /api/chat: 10 questions per minute.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
